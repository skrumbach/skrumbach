{
  "name": "skrumbach-profile",
  "private": true,
  "type": "module",
  "description": "Generates the animated profile SVG for github.com/skrumbach",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/render/fetch.mjs",
    "render": "node scripts/render/render.mjs",
    "build": "npm run fetch && npm run render",
    "sample": "node scripts/render/render.mjs --sample",
    "test": "node --test \"scripts/render/test/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/saira": "5.3.0",
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12"
  }
}
